// SYNTAX TEST "source.cesium" "Operator and Keyword List Tests"

// Compound assignment
x += 1;
//^^ keyword.operator.assignment.compound.cesium
x -= 1;
//^^ keyword.operator.assignment.compound.cesium
x *= 2;
//^^ keyword.operator.assignment.compound.cesium
x /= 2;
//^^ keyword.operator.assignment.compound.cesium
x ^= 2;
//^^ keyword.operator.assignment.compound.cesium
x **= "s";
//^^^ keyword.operator.assignment.compound.cesium
x <<= 2;
//^^^ keyword.operator.assignment.compound.cesium

// Plain assignment and comparison are unaffected
x = y ^ 2;
//^ keyword.operator.assignment.cesium
//    ^ keyword.operator.arithmetic.cesium
if (x <= y) {
//    ^^ keyword.operator.comparison.cesium
}
if (x == y) {
//    ^^ keyword.operator.comparison.cesium
}

// address comparison (#== and #!=), bitwise NOT (!.), the elementwise
// product (.*) and the conditional operator, as the specification has them
if (p #== q) {
//    ^^^ keyword.operator.comparison.address.cesium
}
if (p #!= null) {
//    ^^^ keyword.operator.comparison.address.cesium
}
x = !.y;
//  ^^ keyword.operator.bitwise.not.cesium
z = a .* b;
//    ^^ keyword.operator.arithmetic.elementwise.cesium
m = c ? a : b;
//    ^ keyword.operator.ternary.cesium
//        ^ keyword.operator.ternary.cesium
r = ::x;
//  ^^ keyword.operator.arithmetic.cesium

// import is a keyword
import(std.io) as io;
// <- keyword.other.cesium
//             ^^ keyword.other.cesium

// this and super
this.x = super.x;
// <- variable.language.cesium
//       ^^^^^ variable.language.cesium
