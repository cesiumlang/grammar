{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "cesium",
      "camelcase": "Cesium",
      "scope": "source.cesium",
      "path": ".",
      "file-types": ["csm", "csi"],
      "highlights": "queries/highlights.scm",
      "tags": "queries/tags.scm",
      "injection-regex": "^(cesium|csm)$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for the Cesium programming language",
    "authors": [{ "name": "Randy Eckman" }],
    "links": { "repository": "https://github.com/cesiumlang/grammar" }
  }
}
